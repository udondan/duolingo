{
  "name": "@udondan/duolingo",
  "version": "2.0.0",
  "description": "SDK, CLI and MCP server for Duolingo",
  "author": {
    "name": "Daniel Schroeder",
    "url": "https://www.udondan.com/"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/udondan"
    }
  ],
  "homepage": "https://github.com/udondan/duolingo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udondan/duolingo.git"
  },
  "bugs": {
    "url": "https://github.com/udondan/duolingo/issues"
  },
  "keywords": [
    "duolingo",
    "api",
    "sdk",
    "cli",
    "mcp",
    "mcp-server"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "duolingo": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js mcp",
    "dev": "tsx src/cli.ts mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axios": "1.21.0",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "axios-mock-adapter": "2.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
