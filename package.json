{
  "name": "@udondan/duolingo",
  "version": "1.0.0",
  "description": "Duolingo API client library and MCP server",
  "author": {
    "name": "Daniel Schroeder",
    "url": "https://www.udondan.com/"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/udondan"
    }
  ],
  "homepage": "https://github.com/udondan/duolingo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udondan/duolingo.git"
  },
  "bugs": {
    "url": "https://github.com/udondan/duolingo/issues"
  },
  "keywords": [
    "duolingo",
    "api",
    "mcp"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "duolingo-mcp": "dist/server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "axios": "1.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "3.2.7",
    "axios-mock-adapter": "2.1.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "v26.10.0"
  }
}
